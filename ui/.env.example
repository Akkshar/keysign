# Sign-in (Firebase Auth). Copy to ui/.env and fill in from the Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# Enable Email/Password and Google under Authentication -> Sign-in method, and
# make sure "localhost" is in Authentication -> Settings -> Authorised domains.
# Leave these empty and the dashboard runs without a sign-in screen.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend address (defaults shown)
# VITE_KEYSIGN_HTTP=http://localhost:8000
# VITE_KEYSIGN_WS=ws://localhost:8000/ws/dashboard
# VITE_KEYSIGN_CAPTURE_WS=ws://localhost:8000/ws/capture
