{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "capture",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "capture/serve.js",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--python",
        "3.12",
        "python",
        "-m",
        "backend"
      ],
      "port": 8000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "dashboard",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dashboard-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "dashboard",
        "vite",
        "--port",
        "5174",
        "--strictPort",
        "--config",
        "dashboard/vite.config.js",
        "dashboard"
      ],
      "port": 5174
    }
  ]
}
