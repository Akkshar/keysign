{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "capture",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "capture/serve.js",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--python",
        "3.12",
        "python",
        "-m",
        "backend"
      ],
      "port": 8000
    },
    {
      "name": "ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "ui",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "ui-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "ui",
        "run",
        "dev",
        "--",
        "--port",
        "5176"
      ],
      "port": 5176
    },
    {
      "name": "dashboard-lite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "dashboard",
        "run",
        "dev"
      ],
      "port": 5175
    }
  ]
}
